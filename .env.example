# TraceWrite runs fully offline with NO configuration. These are all OPTIONAL.

# SQLite file (default). The app seeds this automatically on first run.
DATABASE_URL="file:./dev.db"

# OPTIONAL live path. If set, the /api/verify and /api/draft routes can use an
# LLM (tool-calling) instead of the deterministic offline verifier.
# Leave UNSET to keep everything offline and deterministic (the default).
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
