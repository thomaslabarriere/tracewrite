// TraceWrite data model.
//
// Runs on PostgreSQL (Neon) in production via Prisma. The model layer is
// provider-agnostic (only String, Int, DateTime), so it also runs on a local
// SQLite file or the in-memory synthetic fallback with no config. DATABASE_URL
// selects the target; if no database is reachable the app serves the synthetic
// sources from memory (see src/lib/sources-store.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// A synthetic source document (short scientific abstract). SYNTHETIC / DEMO ONLY.
model Source {
  id        String   @id
  title     String
  authors   String
  year      Int
  specialty String // "oncology" | "dermatology"
  body      String // the abstract text; verification matches spans within this
  createdAt DateTime @default(now())
}
